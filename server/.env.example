# Public test stack (docker-compose.yml). Copy to .env and fill in.

# The server's two public IPv4 addresses, both configured on its network interface.
PUBLIC_IP=
PUBLIC_IP2=

# Generate each one with: openssl rand -hex 16
POSTGRES_PASSWORD=
KERBEROS_PASSWORD=

# Grand Prix day boundary, in hours from UTC (Italy = 1, Japan = 9).
GP_UTC_OFFSET=1

# Host folders with the data that is not in the repository.
DATA_DIR=./data
SPOTPASS_DIR=../re/data/spotpass_archive/canonical
