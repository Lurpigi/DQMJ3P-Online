# Public test stack (docker-compose.yml). Copy to .env and fill in.

# The server's two public IPv4 addresses, both configured on its network interface.
PUBLIC_IP=
PUBLIC_IP2=

# Generate each one with: openssl rand -hex 16
POSTGRES_PASSWORD=
KERBEROS_PASSWORD=

# Grand Prix day boundary, in hours from UTC (Italy = 1, Japan = 9).
GP_UTC_OFFSET=1

# Host folders with the data that is not in the repository.
DATA_DIR=./data
SPOTPASS_DIR=../re/data/spotpass_archive/canonical

# Statistics portal (docs/dashboard.md). Leave COMPOSE_PROFILES empty to run the game services only.
COMPOSE_PROFILES=
# Public HTTPS name of the API (DNS A record to PUBLIC_IP), and the GitHub Pages origin allowed to call it
DASHBOARD_HOSTNAME=
DASHBOARD_ALLOWED_ORIGINS=https://lurpigi.github.io
# Generate each one with: openssl rand -hex 16. Keep DASHBOARD_ID_SALT forever: public player
# links are derived from it.
DASHBOARD_IMPORTER_PASSWORD=
DASHBOARD_API_PASSWORD=
DASHBOARD_ID_SALT=
