# Local DEV mode (no Pretendo account/friends services). Copy to .env
PN_DQMJ3P_AUTHENTICATION_SERVER_PORT=45000
PN_DQMJ3P_SECURE_SERVER_HOST=127.0.0.1
PN_DQMJ3P_SECURE_SERVER_PORT=45001
PN_DQMJ3P_KERBEROS_PASSWORD=change-me-16chars
PN_DQMJ3P_POSTGRES_URI=postgres://dqmj3p:dqmj3p@127.0.0.1:54329/dqmj3p?sslmode=disable
PN_DQMJ3P_DEV_PASSWORD=devpassword
PN_DQMJ3P_DEBUG_RMC=1

# Production: remove DEV_PASSWORD (player passwords, see server/README.md). Optional friends service:
# PN_DQMJ3P_FRIENDS_GRPC_HOST= / _PORT= / _API_KEY=
